      "domain": "water",
      "unit": "degC",
      "description": "In-situ water temperature."
    },
    {
      "id": "seaSurfaceTemperature",
      "domain": "water",
      "unit": "degC",
      "description": "Sea surface temperature, in situ or from an external SST product."
    },
    {
      "id": "salinity",
      "domain": "water",
      "unit": "PSU",
      "description": "Practical salinity."
    },
    {
      "id": "waterDepth",
      "domain": "water",
      "unit": "m",
      "description": "Water depth at the capture or sample point."
    },
    {
      "id": "secchiDepth",
      "domain": "water",
      "unit": "m",
      "description": "Secchi disk depth."
    },
    {
      "id": "horizontalVisibility",
      "domain": "water",
      "unit": "m",
      "description": "Underwater or surface horizontal visibility."
    },
    {
      "id": "turbidity",
      "domain": "water",
      "unit": "NTU",
      "description": "Turbidity."
    },
    {
      "id": "ph",
      "domain": "water",
      "unit": "",
      "description": "pH."
    },
    {
      "id": "dissolvedOxygen",
      "domain": "water",
