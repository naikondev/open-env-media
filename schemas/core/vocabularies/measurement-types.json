{
  "name": "measurement-types",
  "title": "EMDP measurement types",
  "description": "Recommended measurementType values. Profiles list which subset they expect. Additional types are allowed; prefer a clear unit and scheme over inventing a near-duplicate term.",
  "terms": [
    {
      "id": "landCoverClass",
      "domain": "land",
      "unit": "",
      "schemeExamples": ["corine", "nlcd", "esa-worldcover", "osm"],
      "description": "Coded land-cover or land-use class."
    },
    {
      "id": "canopyCover",
      "domain": "land",
      "unit": "%",
      "description": "Canopy or tree cover fraction in the frame or plot."
    },
    {
      "id": "snowCover",
      "domain": "land",
      "unit": "%",
      "description": "Snow or ice cover fraction."
    },
    {
      "id": "burnedArea",
      "domain": "land",
      "unit": "%",
      "description": "Burned or scorched fraction visible in the frame or plot."
    },
    {
      "id": "shorelinePosition",
      "domain": "land",
      "unit": "m",
      "description": "Displacement of a shoreline or waterline relative to a marked reference."
    },
    {
      "id": "glacierFrontDistance",
      "domain": "land",
      "unit": "m",
      "description": "Distance from a fixed mark to the visible glacier front."
    },
    {
      "id": "erosionScarpHeight",
      "domain": "land",
      "unit": "m",
      "description": "Visible height of an erosion scarp or bank."
    },
    {
