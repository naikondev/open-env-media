{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-env-media.org/specs/0.3/emdp-profile.json",
  "title": "Environmental Media Data Package",
  "description": "Frictionless Data Package profile for environmental field evidence. Follows the Camtrap DP package graph with observation, measurement, and join tables. Packages SHOULD also be valid Data Packages.",
  "type": "object",
  "required": [
    "id",
    "name",
    "resources",
    "profile",
    "created",
    "contributors",
    "project",
    "spatial",
    "temporal"
  ],
  "properties": {
    "id": {
      "description": "Canonical identifier of this package. Prefer a URI (https or URN). Local table IDs are scoped to this value.",
      "type": "string",
      "minLength": 1
    },
    "name": { "type": "string" },
    "title": { "type": "string" },
    "homepage": {
      "description": "Resolvable landing page for the package, if any.",
      "type": "string",
      "format": "uri"
    },
    "resources": {
      "description": "Exactly one `deployments`, one `media`, and one `observations` resource. Additional uniquely named resources are allowed.",
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["name", "path", "profile", "schema"],
            "properties": {
              "name": { "const": "deployments" },
              "profile": { "const": "tabular-data-resource" },
              "path": { "type": "string" },
              "schema": { "type": "string" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["name", "path", "profile", "schema"],
            "properties": {
              "name": { "const": "media" },
              "profile": { "const": "tabular-data-resource" },
              "path": { "type": "string" },
              "schema": { "type": "string" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["name", "path", "profile", "schema"],
            "properties": {
              "name": { "const": "observations" },
              "profile": { "const": "tabular-data-resource" },
              "path": { "type": "string" },
              "schema": { "type": "string" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "profile": {
      "description": "URL or path of the EMDP profile version used by this package.",
      "type": "string"
    },
    "emdpProfiles": {
      "description": "Domain profile identifiers. Core-only packages may omit this. `attribution` is not part of the scientific core.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "land",
          "rpdp",
          "water",
          "atmosphere",
          "dark-sky",
          "climate",
          "attribution"
        ]
      },
      "uniqueItems": true
    },
    "created": { "type": "string" },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "contact",
              "principalInvestigator",
              "rightsHolder",
              "publisher",
              "contributor"
            ]
          }
        }
      }
    },
    "licenses": {
      "description": "If provided, include at least one license for package data and one for media files.",
      "minItems": 2,
      "items": {
        "required": ["scope"],
        "properties": {
          "scope": {
            "type": "string",
            "enum": ["data", "media"]
          }
        }
      }
    },
    "project": {
      "description": "Study or program that originated the package.",
      "type": "object",
      "required": ["title", "captureMethod", "observationTypes"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "acronym": { "type": "string" },
        "description": { "type": "string" },
        "path": { "type": "string", "format": "uri" },
        "captureMethod": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "handheld",
              "fixedPoint",
              "timeLapse",
              "activityDetection",
              "aerial",
              "underwater",
              "other"
            ]
          }
        },
        "observationTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "landCover",
              "waterQuality",
              "habitatCondition",
              "airQuality",
              "lightPollution",
              "climateEvent",
              "disturbance",
              "restoration",
              "pollution",
              "other"
            ]
          }
        },
        "observationLevel": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["media", "event"]
          }
        }
      }
    },
    "coordinatePrecision": {
      "description": "Least precise published coordinate precision in degrees.",
      "type": "number"
    },
    "spatial": {
      "description": "Spatial coverage as GeoJSON.",
      "type": "object"
    },
    "temporal": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    }
  }
}
